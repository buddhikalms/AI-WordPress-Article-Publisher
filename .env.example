# Core app
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-4.1-mini

# NewsData API (category news auto-publish)
NEWSDATA_API_KEY=your_newsdata_api_key
NEWSDATA_BASE_URL=https://newsdata.io/api/1/news

# Prisma MySQL
DATABASE_URL=mysql://root:your_password%40123@localhost:3306/ai_aricle_publisher
# Needed for MySQL 8 caching_sha2_password when SSL is not configured.
# Keep unset in production if you use TLS or mysql_native_password.
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
APP_ENCRYPTION_KEY=replace_with_32_byte_key_or_hex

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Credentials email verification via SMTP (Gmail app password supported)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=AI Publisher <you@gmail.com>

# Optional contact form notification recipient. Inquiries are stored before email.
CONTACT_NOTIFICATION_EMAIL=support@example.com

# Optional comma separated admin emails
ADMIN_EMAILS=admin@example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional global fallback WordPress credentials (not used when account credentials exist)
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

